      "done",
      "in",
      "function",
      "time",
      "coproc",
      "break",
      "continue",
      "return",
      "local",
      "declare",
      "typeset",
      "export",
      "readonly",
      "unset",
      "shift",
      "source",
      "alias",
      "unalias",
      "trap",
      "set",
